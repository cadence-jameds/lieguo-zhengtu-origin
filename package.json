{
  "name": "guozhan-game-mvp",
  "version": "0.30.42",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "simulate:48h": "vitest run src/devtools/headless48h.test.ts --reporter=verbose",
    "simulate:8h": "vitest run src/devtools/simulation8h.test.ts --reporter=verbose",
    "check": "npm run typecheck && npm run test && npm run build",
    "test:b1": "vitest run src/game/formal/schema.test.ts src/game/formal/scheduler.test.ts src/game/formal/persistence.test.ts src/game/formal/runtime.test.ts src/game/formal/runtimeGraph.test.ts src/game/formal/recoveryR1.test.ts src/game/saveLock.test.ts",
    "test:legacy-active": "vitest run src/game src/devtools/simulation8h.test.ts src/content --exclude \"src/game/formal/**\" --exclude \"src/game/saveLock.test.ts\"",
    "test:prototype": "vitest run src/simulation src/persistence src/map src/devtools/headless48h.test.ts",
    "check:b1": "npm run typecheck && npm run test:b1 && npm run build",
    "test:b2": "vitest run src/game/formal/worldB2.test.ts",
    "test:metrics": "vitest run src/game/formal/metrics.test.ts",
    "test:b3": "vitest run src/game/formal/economyB3.test.ts",
    "test:b4": "vitest run src/game/formal/developmentB4.test.ts src/game/formal/runtimeB4.test.ts",
    "test:presentation": "vitest run src/game/presentation",
    "test:parity": "vitest run src/game/presentation/parity.test.tsx src/game/presentation/mapRaster.test.ts"
  },
  "dependencies": {
    "dexie": "^4.4.5",
    "pixi.js": "^8.20.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.14.5",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
