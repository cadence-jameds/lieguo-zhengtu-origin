{
  "name": "guozhan-game-mvp",
  "version": "0.30.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "simulate:48h": "vitest run src/devtools/headless48h.test.ts --reporter=verbose",
    "simulate:8h": "vitest run src/devtools/simulation8h.test.ts --reporter=verbose",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "dexie": "^4.4.5",
    "pixi.js": "^8.20.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
